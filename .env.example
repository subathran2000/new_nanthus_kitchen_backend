# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nanthus_kitchen
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# JWT - REQUIRED - Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_GENERATE_SECURE_SECRET_MIN_64_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_SECURE_REFRESH_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRATION=7d

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=New Nanthu's Kitchen
SMTP_FROM_EMAIL=noreply@nanthuskitchen.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Logo URL for emails (can be absolute URL or relative to frontend)
LOGO_URL=

# File Upload
UPLOAD_MAX_SIZE=1048576
UPLOAD_DEST=./uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL=900000
LOGIN_THROTTLE_LIMIT=5

# Restaurant Info
RESTAURANT_NAME=New Nanthu's Kitchen
RESTAURANT_TIMEZONE=America/Toronto
RESTAURANT_ADDRESS_MARKHAM=72-30 Karachi Dr, L3S 0B6
RESTAURANT_ADDRESS_SCARBOROUGH=80 Nashdene Rd, M1V 5E4

# Admin Seed Credentials (for initial database seeding only)
# IMPORTANT: Change these values and keep them secure!
ADMIN_SEED_EMAIL=admin@nanthuskitchen.com
ADMIN_SEED_PASSWORD=ChangeThisPassword123!
ADMIN_SEED_FIRST_NAME=Super
ADMIN_SEED_LAST_NAME=Admin

# =================================================================
# PRODUCTION SETTINGS
# =================================================================
# When deploying to production, ensure you:
# 1. Set NODE_ENV=production
# 2. Use strong, unique JWT_SECRET and JWT_REFRESH_SECRET values
# 3. Configure your production database credentials
# 4. Set proper FRONTEND_URL and BACKEND_URL for your domain
# 5. Configure SMTP with production email service
# 6. Set LOGO_URL to your production logo URL
# 7. Change admin seed credentials before running seed
